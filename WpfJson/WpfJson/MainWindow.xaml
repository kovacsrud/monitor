<Window x:Class="WpfJson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfJson"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="37*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="listboxFajlok" ItemsSource="{Binding FileItems,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="200" SelectionChanged="listboxFajlok_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FileName}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            
        </ListBox>
        <Image x:Name="imageKep" Grid.Column="1"/>
        <Button x:Name="buttonTallozas" Content="Fájlok hozzáadása" Width="200" Height="30" FontSize="16" Grid.Row="1" Click="buttonTallozas_Click" Grid.ColumnSpan="2" Margin="300,9,300,9"/>

    </Grid>
</Window>
